#sa_pn_block .sa_hd { position: relative; display: flex; align-items: flex-=
start; }

#sa_pn_block .sa_hd .asInfoWrapper { padding: 8px 0px 0px; position: relati=
ve; display: inline-flex; align-items: flex-start; }

#sa_pn_block .sa_hd .asInfoWrapper .asInfoBtn { width: 16px; height: 16px; =
background-repeat: no-repeat; background-position: center center; backgroun=
d-size: 16px 16px; margin-left: 6px; border: 0px; padding: 0px; cursor: poi=
nter; background-color: transparent; }

#sa_pn_block .sa_hd .asInfoWrapper .infobubble { position: absolute; top: c=
alc(100% + 10px); left: 60%; transform: translateX(-50%); display: inline-b=
lock; min-width: 156px; max-width: 260px; width: auto; background: rgb(255,=
 255, 255); color: rgb(0, 0, 0); border: 1px solid rgb(221, 221, 221); bord=
er-radius: 4px; box-shadow: rgba(0, 0, 0, 0.2) 0px 4px 12px; padding: 12px;=
 font-size: 12px; line-height: 1.4; box-sizing: border-box; white-space: no=
rmal; overflow-wrap: anywhere; }

#sa_pn_block .sa_hd .asInfoWrapper .infobubble::before { content: ""; posit=
ion: absolute; top: 0px; left: 50%; transform: translate(-50%, -50%) rotate=
(45deg); width: 14px; height: 14px; background: rgb(255, 255, 255); border-=
width: 1px 0px 0px 1px; border-style: solid none none solid; border-color: =
rgb(221, 221, 221) currentcolor currentcolor rgb(221, 221, 221); border-ima=
ge: initial; box-shadow: rgba(0, 0, 0, 0.15) -2px -2px 4px -2px; }

#sa_pn_block .sa_hd .asInfoWrapper .infobubble .infobubble-content { displa=
y: block; font-family: Roboto, Arial, Helvetica, sans-serif; font-weight: 4=
00; font-style: normal; font-size: 11px; line-height: 14px; text-transform:=
 none; }

#sa_pn_block .sa_hd .asInfoWrapper .infobubble a { text-decoration: underli=
ne; }

.b_dark #sa_pn_block .sa_hd .asInfoWrapper .infobubble { background: rgb(27=
, 26, 25); color: rgb(210, 208, 206); border-color: rgb(72, 70, 68); box-sh=
adow: rgba(0, 0, 0, 0.6) 0px 4px 12px; }

.b_dark #sa_pn_block .sa_hd .asInfoWrapper .infobubble::before { background=
: rgb(27, 26, 25); border-color: rgb(72, 70, 68); }

#b_copilot_composer_sbox { width: calc(100% - 32px); max-height: calc(-120p=
x + 100vh); max-width: calc(676px); position: absolute; }

#b_copilot_composer_sbox #sw_as_bop .sa_as { bottom: calc(100% + 10px); max=
-width: 100%; border-radius: var(--mai-smtc-corner-ctrl-xlg-rest); backgrou=
nd: rgb(248, 244, 241); box-shadow: rgba(0, 0, 0, 0.1) -5px 4px 12px 0px; }

#sw_as_bop .sa_as #sa_sug_block { max-height: calc(-120px + 100vh); border-=
radius: var(--mai-smtc-corner-ctrl-xlg-rest); border: 1px solid rgba(0, 0, =
0, 0.08); padding: var(--mai-smtc-padding-list-card-default); overflow-y: a=
uto; }

#sw_as_bop .sa_as #sa_ul li { display: flex; cursor: pointer; border-radius=
: 12px; padding: 10px 12px; pointer-events: all; }

#sw_as_bop .sa_sg .sa_sg_icon_area { display: none; }

#sw_as_bop .sa_as #sa_ul li .sa_tm { margin: 0px; white-space: nowrap; over=
flow: hidden; text-overflow: ellipsis; font: var(--bing-smtc-text-global-bo=
dy3); color: var(--smtc-foreground-content-neutral-secondary); }

#sw_as_bop .sa_as #sa_ul li.sa_hv { outline: transparent solid 1px; backgro=
und: rgba(0, 0, 0, 0.05); }

#sw_as_bop .sa_as #sa_ul li.sa_hv:active, #sw_as_bop .sa_as #sa_ul li.sa_hv=
.sa_kb_focus:active { background: rgba(0, 0, 0, 0.03); }

#sw_as_bop .sa_as #sa_ul li.sa_hv.sa_kb_focus { outline: rgb(39, 35, 32) so=
lid 1px; }

.b_bop_cs_sb.b_collapsed_co .b_bop_cs_sb_l .composer_container.chatmode:has=
(.as_bop_multiturn) { flex-direction: column; }

.b_bop_cs_sb.b_collapsed_co #b_bop_cs_sb_place .focusmode:has(.as_bop_multi=
turn) .suggestion_container { display: none; }

@media (min-height: 450px) {
  #sw_as_bop .sa_as #sa_sug_block { padding-block: var(--mai-smtc-padding-l=
ist-card-default); }
}

