------MultipartBoundary--fl45qsPkkijqfHXboOo4FQAl64hVs2Tec7kTW65dIN----
Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: cid:css-db2f678c-adae-4357-98d8-2be6d1e1a006@mhtml.blink

@charset "utf-8";

.hasmic .mic_cont.partner { display: inline-block; }

.mic_cont.partner { margin: 0px 0px 5px 18px; }

.b_deep ul { width: 230px; }

#b_results { width: 648px; }

html body, body #b_header { min-width: var(--bminwidth,1362px); }

#b_context { width: 432px; }

.b_poleContent { width: 1160px; }

@media (max-width: 1406.9px) {
  #b_content { --rgutter: 40px; --crleft: 848px; }
}

@media (max-width: 883.9px) {
  #b_content { --rgutter: 20px; --crleft: 828px; }
}

@media (max-width: 1362.9px) {
  body { --bminwidth: 1232px; }
  #b_context { width: 344px; }
  .b_poleContent { width: 1072px; }
  #id_h #id_rbh, #idCont #id_h #id_rbh { display: none; }
}

@media (max-width: 1274.9px) {
  body { --bminwidth: 1164px; }
  #b_context { width: 256px; }
  #b_header #id_h { right: 0px; }
  #id_h #id_rh, #id_h #id_rbh { padding-left: 8px; }
  .b_poleContent { width: 1004px; }
}

@media (max-width: 1189.9px) {
  body.b_norr #id_h #id_n { display: none; }
  body.b_norr { --bminwidth: 1084px; }
}

@media (max-width: 1138.9px) {
  .b_respl #b_content { --lgutter: 113px; --lgutterrev: -113px; --polepadl:=
 133px; --polepadl2: 133px; --dtabpadl: 125px; --crleft: 801px; --bzaimgoff=
setx: -50px; }
  body .b_scopebar { --lgutter: 113px; }
}

@media (max-width: 1091.9px) {
  .b_respl #b_content { --lgutter: 66px; --lgutterrev: -66px; --polepadl: 8=
6px; --polepadl2: 86px; --dtabpadl: 62px; --crleft: 754px; --bzaimgoffsetx:=
 -97px; }
  body .b_scopebar { --lgutter: 66px; }
}

@media (max-width: 1043.9px) {
  .b_respl #b_content { --lgutter: 18px; --lgutterrev: -18px; --polepadl: 3=
8px; --polepadl2: 38px; --dtabpadl: 12px; --crleft: 706px; --bzaimgoffsetx:=
 -145px; }
  body .b_scopebar { --lgutter: 18px; }
}
