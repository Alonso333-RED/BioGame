.sbiinfbtn { position: absolute; right: 44px; }

.infbtnimg { filter: brightness(1.15); }

.sbiinfbtn:hover .infbtnimg, .sbiinfbtn:focus .infbtnimg { filter: initial;=
 }

@media (forced-colors: active) {
  @media (prefers-color-scheme: light) {
  .infbtnimg, .sbiinfbtn:hover .infbtnimg, .sbiinfbtn:focus .infbtnimg { fi=
lter: brightness(0.5); }
}
  @media (prefers-color-scheme: dark) {
  .infbtnimg, .sbiinfbtn:hover .infbtnimg, .sbiinfbtn:focus .infbtnimg { fi=
lter: brightness(3); }
}
}

.infbtntt, .sbiinfbtn.hdtip:focus .infbtntt, .sbiinfbtn.hdtip:focus-within =
.infbtntt, .sbiinfbtn.hdtip:hover .infbtntt { display: none; }

.sbiinfbtn:hover .infbtntt, .sbiinfbtn:focus .infbtntt, .sbiinfbtn:focus-wi=
thin .infbtntt { display: block; }

.infbtntt { display: none; text-align: left; color: rgb(68, 68, 68); positi=
on: absolute; padding: 12px; width: 175px; right: -42px; background: rgb(25=
5, 255, 255); z-index: 1; top: 24px; margin: 0px; border-radius: 4px; box-s=
hadow: rgba(0, 0, 0, 0.05) 0px 0px 0px 1px, rgba(0, 0, 0, 0.14) 0px 4px 12p=
x 1px; font-family: "Segoe UI", Arial, Helvetica, sans-serif; font-size: 13=
px; line-height: 20px; }

.sbiinflnks { margin: 12px 0px 4px; }

#detailPage #sb_sbisalnk, #detailPage #sb_sbiprilnk, .sbiinflnk { font-size=
: 11px; line-height: 14px; color: rgb(0, 128, 157); }

#detailPage #sb_sbisalnk:hover, #detailPage #sb_sbisalnk:focus, #detailPage=
 #sb_sbiprilnk:hover, #detailPage #sb_sbiprilnk:focus, .sbiinflnk:hover, .s=
biinflnk:focus { text-decoration: underline; }

.sbiinfsep { margin: 0px 8px; }

.infbtntt::before { content: ""; border-width: 1px 0px 0px 1px; border-styl=
e: solid none none solid; border-color: rgb(221, 221, 221) currentcolor cur=
rentcolor rgb(221, 221, 221); border-image: initial; display: block; width:=
 7px; height: 7px; transform: rotate(45deg); background: rgb(255, 255, 255)=
; position: absolute; right: 45px; top: -4px; }

#vsk_sbiinfbtn.sbiinfbtn { position: absolute; top: -14px; right: 16px; dis=
play: block; }

#vsk_sbiinfbtn.sbiinfbtn .infbtntt { right: -6px; }

#vsk_sbiinfbtn.sbiinfbtn .infbtntt::before { right: 10px; }

@media screen and (max-height: 350px) {
  .infbtntt { width: 250px; right: -10px; font-size: 11px; }
  .infbtntt::before { right: 14px; }
  .sbiinflnks { margin: 4px 0px; }
}
