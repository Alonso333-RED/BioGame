------MultipartBoundary--ViRTceyoXyHuMdv4N552fi80QG86Ib04fFvRNEn96Z----
Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: cid:css-98419de7-ce82-42e3-a72b-cdfb717d01e4@mhtml.blink

@charset "utf-8";

#sbiarea, #sbicom { display: none; }

.hassbi #sbiarea { display: inline-block; }

#sbiarea { margin: 0px 0px 0px 18px; }

.sbox #sb_form #sbiarea { margin: 0px; }

#sb_sbi { display: inline-block; cursor: pointer; }

img#sbi_b { vertical-align: -2px; height: 18px; width: 18px; }

#detailPage #detailheader img#sbi_b, .blue2#miniheader img#sbi_b, .sbox img=
#sbi_b { vertical-align: -3px; }

.blue2#miniheader img#sbi_b { vertical-align: -1px; }

#sbi_b.grayscaled { filter: grayscale(1) brightness(1.4); }

#sbi_b.grayscaled:hover { filter: grayscale(1) brightness(1); }

#sb_sbip[shdlg] #sbi_b { filter: grayscale(0); }

#sb_sbip .rms_iac { display: inline-block; }

#sb_sbip:not(.disableTooltip):hover::before, #sb_sbip.shtip:not(.disableToo=
ltip)::before, #sb_sbip[vptest]::before { bottom: -27px; left: 10px; z-inde=
x: 6; }

#sb_sbip:not(.disableTooltip):hover::after, #sb_sbip.shtip:not(.disableTool=
tip)::after, #sb_sbip[vptest]::after { top: 40px; left: 10px; z-index: 4; }

#hp_container #sb_sbip:not(.disableTooltip):hover::before, #hp_container #s=
b_sbip.shtip:not(.disableTooltip)::before { bottom: -21px; left: 12px; }

#hp_container #sb_sbip:not(.disableTooltip):hover::after, #hp_container #sb=
_sbip.shtip:not(.disableTooltip)::after { top: 38px; left: 12px; }

#miniheader #sb_sbip:not(.disableTooltip):hover::before, #miniheader #sb_sb=
ip.shtip:not(.disableTooltip)::before { bottom: -23px; }

#miniheader #sb_sbip:not(.disableTooltip):hover::after, #miniheader #sb_sbi=
p.shtip:not(.disableTooltip)::after { top: 36px; }

#sb_sbip[shdlg]:hover::before, #sb_sbip[shdlg]:hover::after, #sb_sbip[shdlg=
].shtip::before, #sb_sbip[shdlg].shtip::after { display: none; }

.hassbi #sbicom { position: absolute; display: block; }

