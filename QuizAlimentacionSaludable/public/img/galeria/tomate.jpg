  .contents { margin: 0px 20px; }
  .flagIcon { margin-left: 20px; }
}

@media (max-width: 420px) {
  #fbdialog { left: 3%; }
  .contents { margin: 0px 10px; }
  .flagIcon { margin-left: 10px; margin-right: 10px; }
}

@media only screen and (max-height: 480px) {
  #fbdialog { top: 3%; line-height: 0.8em; }
  .flagIcon { width: 8px; height: 8px; }
  .message { padding: 3px 0px 4px; }
  #fbdialog_thumb_container > img { max-height: 140px; max-width: 140px; }
  .fbdialog .title { font-size: 8px; padding-top: 1px; }
  #fbdialog .contents { font-size: 6px; }
  #adult_button_submit, #adult_button_cancel { width: 30%; }
  #fbdialog .buttonLink { font-size: 6px; padding: 2px; margin-left: 3px; }
