mily); font-feature-settings: "tnum"; font-variant-numeric: tabular-nums; d=
isplay: inline-block; text-align: right; }

div[data-rewards-widget].medallion:not(.copilotSearch) div.medal { position=
: relative; }

@keyframes rw-medal-ripple {=20
  0% { box-shadow: rgba(78, 131, 246, 0) 0px 0px 0px 0px, rgb(78, 131, 246)=
 0px 0px 0px 2px; opacity: 1; }
  20% { box-shadow: rgba(78, 131, 246, 0.5) 0px 0px 0px 2px, rgba(78, 131, =
246, 0.8) 0px 0px 0px 2px; opacity: 1; }
  50% { box-shadow: rgba(78, 131, 246, 0.3) 0px 0px 0px 6px, rgba(78, 131, =
246, 0.5) 0px 0px 0px 2px; opacity: 0.8; }
  80% { box-shadow: rgba(78, 131, 246, 0.15) 0px 0px 0px 8px, rgba(78, 131,=
 246, 0.2) 0px 0px 0px 2px; opacity: 0.3; }
  100% { box-shadow: rgba(78, 131, 246, 0) 0px 0px 0px 12px, rgba(78, 131, =
246, 0) 0px 0px 0px 2px; opacity: 0; }
}

div[data-rewards-widget].medallion.glow-medal:not(.copilotSearch):not(.froz=
en):not(.ocean-commotion) div.medal::after { content: ""; position: absolut=
e; top: 50%; left: 50%; width: 29px; height: 29px; border-radius: 50%; tran=
sform: translate(-50%, -50%); opacity: 0; animation: 1s ease-out 0s 3 norma=
l none running rw-medal-ripple; pointer-events: none; }

div[data-rewards-widget].medallion:not(.copilotSearch) svg.medal-circled { =
width: 32px; height: 32px; fill: var(--rw-color, var(--rw-medal-color)); }

div[data-rewards-widget].medallion svg.medal-new-level { width: 20px; heigh=
t: 20px; }

div[data-rewards-widget].medallion svg.medal-newlevel-circled { width: 32px=
; height: 32px; }

div[data-rewards-widget].medallion svg.medal-circled circle { stroke: var(-=
-rw-color, var(--rw-medal-color)); }

div[data-rewards-widget].medallion .light-ring svg.medal-circled circle { o=
pacity: 0.3; }

div[data-rewards-widget].medallion svg.medal-light { width: 32px; height: 3=
2px; fill: var(--rw-color, var(--rw-medal-color)); }

div[data-rewards-widget].medallion .red-dot { width: var(--rw-red-dot-diame=
ter); height: var(--rw-red-dot-diameter); border-radius: 50%; background-co=
lor: var(--rw-red-dot-color); top: -3px; right: 1px; position: absolute; }

div[data-rewards-widget].medallion .red-dot.adjacent { right: 0px; top: 0px=
; }

div[data-rewards-widget].medallion.copilotSearch .points-container { color:=
 var(--acf-color-fore-neutral-quaternary, rgba(0, 0, 0, 0.6)); text-align: =
center; font-size: 13px; font-style: normal; font-weight: 400; line-height:=
 20px; }

div[data-rewards-widget].medallion.copilotSearch .b_clickarea:hover .points=
-container { color: var(--acf-color-fore-neutral-secondary, rgba(0, 0, 0, 0=
.8)); }

div[data-rewards-widget].medallion.copilotSearch.rw-dark .points-container =
{ color: var(--acf-color-fore-neutral-quaternary, rgba(255, 255, 255, 0.6))=
; }

div[data-rewards-widget].medallion.copilotSearch.rw-dark .b_clickarea:hover=
 .points-container { color: var(--acf-color-fore-neutral-secondary, rgba(25=
5, 255, 255, 0.8)); }

div[data-rewards-widget].medallion.copilotSearch div.medal { display: flex;=
 align-items: center; justify-content: inherit; }

div[data-rewards-widget].medallion.copilotSearch svg.medal-circled { fill: =
black; height: 17px; fill-opacity: 0.6; }

div[data-rewards-widget].medallion.copilotSearch .b_clickarea:hover svg.med=
al-circled { fill: rgb(32, 32, 32); fill-opacity: unset; }

div[data-rewards-widget].medallion.copilotSearch.rw-dark svg.medal-circled =
{ fill: white; }

div[data-rewards-widget].medallion.copilotSearch.rw-dark .b_clickarea:hover=
 svg.medal-circled { fill: rgb(207, 222, 255); }
------MultipartBoundary--ViRTceyoXyHuMdv4N552fi80QG86Ib04fFvRNEn96Z----
Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: cid:css-323e5c9f-3d50-44db-a639-1175b72a62da@mhtml.blink

@charset "utf-8";

.hasmic .mic_cont.partner { display: inline-block; }

.mic_cont.partner { margin: 0px 0px 5px 18px; }

.b_deep ul { width: 230px; }

#b_results { width: 648px; }

html body, body #b_header { min-width: var(--bminwidth,1362px); }

#b_context { width: 432px; }

.b_poleContent { width: 1160px; }

@media (max-width: 1406.9px) {
  #b_content { --rgutter: 40px; --crleft: 848px; }
}

@media (max-width: 883.9px) {
  #b_content { --rgutter: 20px; --crleft: 828px; }
}

@media (max-width: 1362.9px) {
  body { --bminwidth: 1232px; }
  #b_context { width: 344px; }
  .b_poleContent { width: 1072px; }
  #id_h #id_rbh, #idCont #id_h #id_rbh { display: none; }
}

@media (max-width: 1274.9px) {
  body { --bminwidth: 1164px; }
  #b_context { width: 256px; }
  #b_header #id_h { right: 0px; }
  #id_h #id_rh, #id_h #id_rbh { padding-left: 8px; }
  .b_poleContent { width: 1004px; }
}

@media (max-width: 1189.9px) {
  body.b_norr #id_h #id_n { display: none; }
  body.b_norr { --bminwidth: 1084px; }
}

@media (max-width: 1138.9px) {
  .b_respl #b_content { --lgutter: 113px; --lgutterrev: -113px; --polepadl:=
 133px; --polepadl2: 133px; --dtabpadl: 125px; --crleft: 801px; --bzaimgoff=
setx: -50px; }
  body .b_scopebar { --lgutter: 113px; }
}

@media (max-width: 1091.9px) {
  .b_respl #b_content { --lgutter: 66px; --lgutterrev: -66px; --polepadl: 8=
6px; --polepadl2: 86px; --dtabpadl: 62px; --crleft: 754px; --bzaimgoffsetx:=
 -97px; }
  body .b_scopebar { --lgutter: 66px; }
}

@media (max-width: 1043.9px) {
  .b_respl #b_content { --lgutter: 18px; --lgutterrev: -18px; --polepadl: 3=
8px; --polepadl2: 38px; --dtabpadl: 12px; --crleft: 706px; --bzaimgoffsetx:=
 -145px; }
  body .b_scopebar { --lgutter: 18px; }
}
